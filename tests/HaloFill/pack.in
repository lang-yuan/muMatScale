BaseFileName  test			/* Identify cases*/

NSubblocks 2 2 2            		/* NO. of sub-blocks in x,y,z: int int int  */
NCellsPerSB 8  12  4       		/* NO of Cells in each subblock: int int int   */
FaceCtrl  0 0 0 0 0 0      		/* 0 = wrap or 1 = pad each face */

CellSize 5.0e-06          		/* Grid size in Meters */
